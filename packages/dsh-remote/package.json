{
  "name": "dsh-remote",
  "version": "0.1.0",
  "description": "Authenticated remote API endpoint for DeepSeek Harness: exposes the same /api RPC + SSE event streams as the Web frontend on a standalone HTTP(S) port with bearer-token auth. Pure plugin, no dsh core changes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "gen-token": "node scripts/gen-token.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote",
    "ios"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1"
  }
}
