# vendored copy belongs here.
node_modules/
vendor/
dist/
build/
*.tgz
*.log
.npm/
.pnpm-store/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
