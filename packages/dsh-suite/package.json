{
  "name": "@local/dsh-suite",
  "version": "0.1.0",
  "description": "Installable DeepSeek Harness suite: the Super Agent panel plus the authenticated remote API the DSH Remote iPhone app talks to.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "install.sh",
    "uninstall.sh",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@local/dsh-super-agent": "file:../dsh-super-agent",
    "dsh-remote": "file:../dsh-remote"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "super-agent",
    "remote",
    "ios"
  ]
}
